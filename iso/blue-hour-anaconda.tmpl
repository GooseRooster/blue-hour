# blue-hour Anaconda installer overrides, injected into the installer runtime
# by `just iso-direct` via build-container-installer's ADDITIONAL_TEMPLATES.
#
# This is a lorax template (Mako + a tiny command language). `append FILE
# STRING` adds a line to FILE inside the installer's root filesystem,
# creating it if needed. Anaconda loads its configuration in this order:
#
#   1. /etc/anaconda/anaconda.conf          (defaults)
#   2. /etc/anaconda/profile.d/*.conf       (selected profile)
#   3. /etc/anaconda/conf.d/*.conf          (custom, highest priority)
#
# so a conf.d drop-in overrides whatever profile the installer variant chose.
#
# Why this exists: some profiles (fedora-kde -> kinoite, fedora-workstation ->
# silverblue) hide NetworkSpoke/PasswordSpoke/UserSpoke, deferring account
# creation to a first-boot initial-setup that does not exist on this image,
# which leaves a locked root-only system. Revealing the spokes here means a
# user + root password are always configured at install time, whichever
# variant is used, while keeping the base Fedora installer theme. Storage is
# reset from the Server profile's XFS-on-LVM default to the base Fedora
# default (Btrfs + zstd:1) plus its `/` + `/home` layout.

append etc/anaconda/conf.d/zz-blue-hour.conf "[User Interface]"
append etc/anaconda/conf.d/zz-blue-hour.conf "custom_stylesheet = /usr/share/anaconda/pixmaps/fedora.css"
append etc/anaconda/conf.d/zz-blue-hour.conf "hidden_spokes ="
append etc/anaconda/conf.d/zz-blue-hour.conf "[Storage]"
append etc/anaconda/conf.d/zz-blue-hour.conf "default_scheme = BTRFS"
append etc/anaconda/conf.d/zz-blue-hour.conf "btrfs_compression = zstd:1"
append etc/anaconda/conf.d/zz-blue-hour.conf "file_system_type ="
append etc/anaconda/conf.d/zz-blue-hour.conf "default_partitioning ="
append etc/anaconda/conf.d/zz-blue-hour.conf "    /     (min 1 GiB, max 70 GiB)"
append etc/anaconda/conf.d/zz-blue-hour.conf "    /home (min 512 MiB, free 50 GiB)"
