#!/usr/bin/bash
# Dev/VM helper: write a fake staged-update status file.
#
# Lets you exercise the update notification (blue-hour-update-notify.service)
# and the Noctalia tray dot without waiting for (or being able to fetch) a real
# bootc update. Run as root via `ujust blue-hour-test-update`. The digest is
# unique per invocation, so the notifier treats each call as a new staged
# deployment. See docs/testing.md.
set -euo pipefail

version="${1:-test-1.0}"
out="/run/blue-hour/update-status.json"

mkdir -p /run/blue-hour
tmp="$(mktemp)"
now="$(date +%s)"

jq -n \
  --arg version "$version" \
  --arg digest "sha256:test-${now}" \
  --argjson checkedAt "$now" \
  '{
     staged: true,
     stagedVersion: $version,
     stagedDigest: $digest,
     bootedVersion: "test-0.9",
     bootedDigest: "sha256:booted",
     updateAvailable: true,
     checkedAt: $checkedAt
   }' >"$tmp"

chmod 0644 "$tmp"
mv -f "$tmp" "$out"
echo "blue-hour: wrote simulated staged status to $out"
