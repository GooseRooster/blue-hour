#!/usr/bin/bash
# Notify active graphical sessions that automatic Flatpak setup failed.
#
# Pulled in by OnFailure= from system-flatpak-setup.service (drop-in:
# files/system/usr/lib/systemd/system/system-flatpak-setup.service.d/). The
# default-flatpaks module itself runs with notify:false, so this is the only
# flatpak-setup notification the user ever sees. This script always exits 0 so
# a notification failure never masks the original unit failure.
set -euo pipefail

unit="${1:-system-flatpak-setup.service}"

for bus in /run/user/*/bus; do
  [ -S "$bus" ] || continue
  uid="$(basename "$(dirname "$bus")")"
  user="$(getent passwd "$uid" | cut -d: -f1)" || continue
  [ -n "$user" ] || continue

  runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
    notify-send --app-name="Flatpak Setup" \
    "Automatic Flatpak setup failed" \
    "$unit did not finish cleanly. See: journalctl -u $unit" || true
done

exit 0
