#!/usr/bin/bash
# blue-hour Sway session wrapper.
#
# Ly launches the session from sway.desktop; this wrapper sets the session
# environment before the compositor starts (some variables, e.g. the toolkit
# backends, must be present *before* sway, and SSH_AUTH_SOCK needs the runtime
# dir, so they cannot live in sway's own config). Ported from nixos-config
# modules/desktop/sway.nix (programs.sway.extraSessionCommands).
set -euo pipefail

# Wayland-first backends for common toolkits, Electron and Firefox.
export GDK_BACKEND="wayland,x11"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export MOZ_ENABLE_WAYLAND=1

# Session identity (a bare Ly Wayland session does not set these).
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sway
export XDG_CURRENT_DESKTOP=sway

# gcr-ssh-agent (gcr >= 4) exposes its socket here but only sets the systemd
# user environment, which a bare Sway session never imports. Export it so
# shells and GUI apps inherit it.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/gcr/ssh"

# The NixOS config forces the Vulkan renderer for HDR10 output. It is left off
# here because it is not reliable under QEMU's virtio-gpu; uncomment on real
# hardware (see docs/port-plan.md phase 3).
# export WLR_RENDERER=vulkan

exec /usr/bin/sway "$@"
